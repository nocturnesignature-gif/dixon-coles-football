{
  "version": 2,
  "builds": [
    {"src": "api/gateway.py", "use": "@vercel/python", "config": {"includeFiles": ["api/**", "src/**"]}},
    {"src": "*.html", "use": "@vercel/static"}
  ],
  "crons": [
    {"path": "/api/generate-forecasts", "schedule": "0 6 * * *"},
    {"path": "/api/daily-recap", "schedule": "0 7 * * *"},
    {"path": "/api/collect-results", "schedule": "0 23 * * *"},
    {"path": "/api/sync-odds", "schedule": "0 9 * * *"},
    {"path": "/api/check-alerts", "schedule": "0 12 * * *"}
  ],
  "routes": [
    {"src": "/api/(.*)", "dest": "/api/gateway.py"},
    {"handle": "filesystem"},
    {"src": "/", "dest": "/index.html"}
  ]
}
